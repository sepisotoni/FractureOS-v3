[Unit]
Description=FractureOS TomTom LAN address forwarding
After=network-online.target
Wants=network-online.target
BindsTo=sys-subsystem-net-devices-enx9abda0e24f81.device
After=sys-subsystem-net-devices-enx9abda0e24f81.device
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fracture-tomtom-lan start
ExecStop=/usr/local/sbin/fracture-tomtom-lan stop
[Install]
WantedBy=multi-user.target

[Unit]
Description=FractureOS TomTom LAN forwarding on %i
After=network-online.target sys-subsystem-net-devices-%i.device
Wants=network-online.target
BindsTo=sys-subsystem-net-devices-%i.device
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/fracture-tomtom-lan start %i
ExecStop=/usr/local/sbin/fracture-tomtom-lan stop %i
